        },
        {
          "@type": "ViewAction",
          "target": "https://pactcase.com/pages/a1c-converter",
          "name": "A1C to Glucose Converter"
        },
        {
          "@type": "ViewAction",
          "target": "https://pactcase.com/pages/blood-pressure-checker",
          "name": "Blood Pressure Checker"
        },
        {
          "@type": "ViewAction",
          "target": "https://pactcase.com/pages/bmi-calculator",
          "name": "BMI Calculator"
        },
        {
          "@type": "ViewAction",
          "target": "https://pactcase.com/pages/daily-calorie-calculator",
          "name": "Daily Calorie Calculator"
        },
        {
          "@type": "ViewAction",
          "target": "https://pactcase.com/pages/pregnancy-due-date-calculator",
          "name": "Pregnancy Due Date Calculator"
        },
        {
          "@type": "ViewAction",
          "target": "https://pactcase.com/pages/target-heart-rate-calculator",
          "name": "Target Heart Rate Calculator"
        }
      ],
      "offers": {
        "@type": "Offer",
        "shippingDetails": [
          // 美国运费 (USD) - 标准和快速
          {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "USD" },
            "shippingLabel": "Standard US Shipping",
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {"@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY"},
              "transitTime": {"@type": "QuantitativeValue", "minValue": 5, "maxValue": 8, "unitCode": "DAY"}
            },
            "shippingDestination": [{"@type": "DefinedRegion", "addressCountry": "US"}]
          },
          // 加拿大运费 (CAD) - 标准
          {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "CAD" }, 
            "shippingLabel": "Standard Canada Shipping",
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {"@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY"},
              "transitTime": {"@type": "QuantitativeValue", "minValue": 5, "maxValue": 8, "unitCode": "DAY"} 
            },
            "shippingDestination": [{"@type": "DefinedRegion", "addressCountry": "CA"}]
          },
          // 英国运费 (GBP) - 标准
          {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "GBP" }, 
            "shippingLabel": "Standard UK Shipping",
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {"@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY"},
              "transitTime": {"@type": "QuantitativeValue", "minValue": 5, "maxValue": 8, "unitCode": "DAY"} 
