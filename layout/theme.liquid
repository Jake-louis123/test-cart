      "naics": "424210",
      "logo": "https://cdn.shopify.com/s/files/1/0630/6227/8257/files/PACT-CASE-LOGO_2.png?v=1752112850",
      "description": "At Pact Case, we help you keep the gentle pact you make with your well-being. <a href='https://pactcase.com/products/weekly-pill-organizer'>The premium pill & supplement case, reimagined</a>. No missed doses, no messed plans: Your tiny win, every day.</a>",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+1 806 283-8130",
          "contactType": "customer service",
          "availableLanguage": "English"
        },
        {
          "@type": "ContactPoint",
          "email": "hi@pactcase.com",
