<script>
  document.addEventListener('DOMContentLoaded', function() {
    const unitSelector = document.getElementById('unitSelector');
    const metricInputs = document.getElementById('metricInputs');
    const imperialInputs = document.getElementById('imperialInputs');
    const calculateButton = document.getElementById('calculateButton');
    const resultContainer = document.getElementById('resultContainer');
    const ctaContainer = document.getElementById('ctaContainer');
    const bmiValue = document.getElementById('bmiValue');
    const bmiCategory = document.getElementById('bmiCategory');
    const bmiNeedle = document.getElementById('bmiNeedle');
    const dynamicCta = document.getElementById('dynamicCta');
    
    // Handle unit switching
    unitSelector.addEventListener('change', function(e) {
      if (e.target.value === 'metric') {
        metricInputs.style.display = 'block';
        imperialInputs.style.display = 'none';
      } else if (e.target.value === 'imperial') {
        metricInputs.style.display = 'none';
        imperialInputs.style.display = 'block';
      }
    });
    
    // Calculate BMI
    calculateButton.addEventListener('click', function() {
      // Reset previous errors
      document.querySelectorAll('.error-message').forEach(el => el.textContent = '');
      document.querySelectorAll('input').forEach(el => el.classList.remove('error'));
      
      // Get selected unit
      const selectedUnit = document.querySelector('input[name="units"]:checked').value;
      
      let bmi = 0;
      let isValid = true;
      
      if (selectedUnit === 'metric') {
        const heightCm = parseFloat(document.getElementById('height-cm').value);
        const weightKg = parseFloat(document.getElementById('weight-kg').value);
        
        // Validate inputs
        if (isNaN(heightCm) || heightCm <= 0) {
          document.getElementById('height-cm-error').textContent = 'Please enter a valid height';
          document.getElementById('height-cm').classList.add('error');
          isValid = false;
        }
        
        if (isNaN(weightKg) || weightKg <= 0) {
          document.getElementById('weight-kg-error').textContent = 'Please enter a valid weight';
          document.getElementById('weight-kg').classList.add('error');
          isValid = false;
        }
        
        if (isValid) {
          // Convert height to meters
          const heightM = heightCm / 100;
          // Calculate BMI: weight (kg) / height^2 (m)
          bmi = weightKg / (heightM * heightM);
        }
      } else {
        const heightFt = parseFloat(document.getElementById('height-ft').value);
        const heightIn = parseFloat(document.getElementById('height-in').value || 0);
        const weightLbs = parseFloat(document.getElementById('weight-lbs').value);
        
        // Validate inputs
        if (isNaN(heightFt) || heightFt <= 0) {
          document.getElementById('height-ft-error').textContent = 'Please enter a valid height';
          document.getElementById('height-ft').classList.add('error');
          isValid = false;
        }
        
        if (isNaN(heightIn) || heightIn < 0 || heightIn >= 12) {
          document.getElementById('height-in-error').textContent = 'Please enter a valid value (0-11)';
          document.getElementById('height-in').classList.add('error');
          isValid = false;
        }
        
        if (isNaN(weightLbs) || weightLbs <= 0) {
          document.getElementById('weight-lbs-error').textContent = 'Please enter a valid weight';
          document.getElementById('weight-lbs').classList.add('error');
          isValid = false;
        }
        
        if (isValid) {
          // Convert height to inches
          const totalInches = (heightFt * 12) + heightIn;
          // Calculate BMI: (weight (lbs) / height^2 (in)) * 703
          bmi = (weightLbs / (totalInches * totalInches)) * 703;
        }
      }
      
      if (isValid) {
        // Display the BMI result
        bmiValue.textContent = bmi.toFixed(1);
        
        // Set category and color
        let category = '';
        let categoryClass = '';
        let needleRotation = 0;
        let ctaText = '';
        
        // Calculate needle rotation (from -90 to +90 degrees)
        // BMI range typically from 15 to 40 for visualization
        needleRotation = ((bmi - 15) / 25) * 180 - 90;
        if (needleRotation < -90) needleRotation = -90;
        if (needleRotation > 90) needleRotation = 90;
        
        if (bmi < 18.5) {
          category = 'Underweight';
          categoryClass = 'category-info';
          ctaText = "No need to stress—this is the perfect time to start nurturing your body back to a more comfortable weight! When you're on the lighter side, it's not just about eating more; it's about getting the right nutrients—like protein powders or B vitamins your doctor might suggest—to help you feel stronger.<br><br>We've all been there: rushing out the door and realizing you skipped your supplements… again. Our pill organizer takes the hassle out of it. Fill it up once a week, tuck it in your bag or leave it by your coffee mug, and those little reminders will be hard to miss. It's one less thing to worry about, so you can focus on fueling your body right. You've got this—take it step by step.";
        } else if (bmi < 25) {
          category = 'Normal Weight';
          categoryClass = 'category-normal';
          ctaText = "Fantastic job keeping your weight in a healthy range—that's no small feat, and you should be proud! To keep that momentum going, getting all your daily vitamins and minerals is key. Let's be real, though—who hasn't forgotten to take their supplements in the rush of the day?<br><br>Our pill organizer is here to make it effortless. Pop your daily supplements into the labeled compartments (1, 2, 3) once a week, and you'll never second-guess if you took them. It's like a little daily reminder that you're nailing this whole health thing. Keep up the great work, and let this tiny tool make your routine even smoother.";
        } else if (bmi < 30) {
          category = 'Overweight';
          categoryClass = 'category-warning';
          ctaText = "You're already taking a great first step by checking in—props to you! When you're looking to shed a few pounds, it's easy to accidentally skimp on key nutrients. Think fiber to keep you full, vitamin C for energy, or calcium to support your metabolism—your doctor might mention these.<br><br>Let's be honest: remembering to take supplements daily? Tricky. Our pill organizer simplifies it. Divvy up your daily doses into 1/2/3 slots, and it'll sit there, quietly reminding you. No more 'Did I take that today?' stress. Just one small tool to help you stay on track, so you can focus on balanced meals and moving your body. You've got this—take it slow.";
        } else {
          category = 'Obese';
          categoryClass = 'category-danger';
          ctaText = "Kudos to you for taking this step—that's courage, and it matters. When working toward a healthier weight, your body might need extra support: things like omega-3s for metabolism, vitamin D for energy, or magnesium to keep things balanced—your doctor may suggest these.<br><br>We get it: life gets busy, and supplements often fall through the cracks. 'Did I take that this morning?' It's a common hassle. Our pill organizer fixes that. Fill it once a week, with clear labels for each day and meal, and it becomes a gentle nudge instead of a chore. No more guilt, no more confusion—just one less thing to think about. You're on the right path, and this little tool is here to walk beside you.";
        }
        
        bmiCategory.textContent = category;
        bmiCategory.className = 'result-category ' + categoryClass;
        bmiNeedle.style.transform = `rotate(${needleRotation}deg)`;
        
        // Display CTA based on result
        dynamicCta.innerHTML = ctaText;
        
        // Show results
        resultContainer.classList.add('show');
        ctaContainer.style.display = 'block';
        
        // Scroll to results
        resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });
</script>

