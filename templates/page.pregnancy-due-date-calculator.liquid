<script>
  document.addEventListener('DOMContentLoaded', function() {
    const calculateButton = document.getElementById('calculateButton');
    const resultContainer = document.getElementById('resultContainer');
    const ctaContainer = document.getElementById('ctaContainer');
    const dueDate = document.getElementById('dueDate');
    const gestationalAge = document.getElementById('gestationalAge');
    const dynamicCta = document.getElementById('dynamicCta');
    
    let pregnancyChart = null;
    
    // Set max date to today (can't select future dates)
    const today = new Date();
    const dateInput = document.getElementById('lmp-date');
    dateInput.max = today.toISOString().split('T')[0];
    
    // Calculate due date
    calculateButton.addEventListener('click', function() {
      // Reset previous errors
      document.querySelectorAll('.error-message').forEach(el => el.textContent = '');
      document.querySelectorAll('input').forEach(el => el.classList.remove('error'));
      
      // Get input
      const lmpDate = new Date(document.getElementById('lmp-date').value);
      
      let isValid = true;
      
      // Validate input
      if (isNaN(lmpDate.getTime())) {
        document.getElementById('lmp-date-error').textContent = 'Please select a valid date';
        document.getElementById('lmp-date').classList.add('error');
        isValid = false;
      } else if (lmpDate > today) {
        document.getElementById('lmp-date-error').textContent = 'Date cannot be in the future';
        document.getElementById('lmp-date').classList.add('error');
        isValid = false;
      }
      
      if (isValid) {
        // Calculate due date using Naegele's Rule
        // Due date = LMP + 280 days (or LMP - 3 months + 7 days + 1 year)
        const dueDateCalc = new Date(lmpDate);
        dueDateCalc.setDate(dueDateCalc.getDate() + 280);
        
        // Format due date as Month DD, YYYY
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        const formattedDueDate = dueDateCalc.toLocaleDateString('en-US', options);
        
        // Calculate current gestational age
        const pregnancyDuration = today - lmpDate;
        const pregnancyDays = Math.floor(pregnancyDuration / (1000 * 60 * 60 * 24));
        const pregnancyWeeks = Math.floor(pregnancyDays / 7);
        const remainingDays = pregnancyDays % 7;
        
        // Update the display
        dueDate.textContent = formattedDueDate;
        gestationalAge.textContent = `${pregnancyWeeks} weeks and ${remainingDays} days`;
        
        // Create pregnancy timeline chart
        createPregnancyChart(pregnancyWeeks, remainingDays);
        
        // Determine trimester and set CTA
        let ctaText = '';
        
        if (pregnancyWeeks <= 12) {
          // First trimester
          ctaText = "Yay, congratulations on this amazing journey—how exciting to be in this early, special phase! We all know how much little things matter right now, and that folic acid? Total non-negotiable. But let's be honest: between morning sickness (if you're dealing with that) and the whirlwind of new emotions, remembering to take it every single day? It can slip through the cracks.<br><br>Our pill organizer? It's basically a tiny, reassuring helper. Made with food-grade, BPA-free materials (no worries there), it's simple to fill once a week—just pop your prenatal vitamins in the daily slots, and leave it somewhere you'll see it: next to your toothbrush, on the kitchen counter, wherever works. No more \"Did I take that today?\" panic. It's one small thing to make this phase feel a little calmer, so you can soak in all the joy. Mamas-to-be deserve that peace of mind.";
        } else {
          // Second/Third trimester
          ctaText = "Look at you—your little one's growing, and so is that list of good stuff they need: calcium for those tiny bones, iron to keep energy up, DHA for brain development… phew, that's a lot to keep track of! And let's not forget \"pregnancy brain\"—we've all been there, staring at a supplement bottle and thinking, \"Did I take this already?\"<br><br>Our pill organizer is here to save the day. Sort out your daily supplements once a week, and those 1, 2, 3 labeled compartments will make it crystal clear what to take when. No more second-guessing, no more stress. Just grab and go, knowing you're giving your baby (and yourself!) exactly what they need. Makes this busy phase feel a little more manageable.";
        }
        
        // Update CTA
        dynamicCta.innerHTML = ctaText;
        
        // Show results
        resultContainer.classList.add('show');
        ctaContainer.style.display = 'block';
        
        // Scroll to results
        resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
    
    // Create pregnancy timeline chart
    function createPregnancyChart(weeks, days) {
      const ctx = document.getElementById('pregnancyChart').getContext('2d');
      
      // Destroy previous chart if exists
      if (pregnancyChart) {
        pregnancyChart.destroy();
      }
      
      // Calculate pregnancy progress
      const totalWeeks = 40;
      const currentProgress = weeks + (days / 7);
      const percentComplete = (currentProgress / totalWeeks) * 100;
      
      // Create the segments for each trimester
      const firstTrimester = 12;
      const secondTrimester = 14; // 13-26 weeks
      const thirdTrimester = 14; // 27-40 weeks
      
      // Calculate which trimester the person is in
      let currentTrimester = 1;
      if (weeks > 26) {
        currentTrimester = 3;
      } else if (weeks > 12) {
        currentTrimester = 2;
      }
      
      // Create chart
      pregnancyChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Pregnancy Timeline'],
          datasets: [
            {
              label: 'First Trimester',
              data: [firstTrimester],
              backgroundColor: currentTrimester === 1 ? '#2D5F5D' : '#84B7B6',
              borderColor: '#E8F3F3',
              borderWidth: 1
            },
            {
              label: 'Second Trimester',
              data: [secondTrimester],
              backgroundColor: currentTrimester === 2 ? '#2D5F5D' : '#84B7B6',
              borderColor: '#E8F3F3',
              borderWidth: 1
            },
            {
              label: 'Third Trimester',
              data: [thirdTrimester],
              backgroundColor: currentTrimester === 3 ? '#2D5F5D' : '#84B7B6',
              borderColor: '#E8F3F3',
              borderWidth: 1
            }
          ]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: {
              stacked: true,
              max: 40,
              title: {
                display: true,
                text: 'Weeks',
                color: '#333333'
              }
            },
            y: {
              stacked: true,
              grid: {
                display: false
              }
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                padding: 15
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const trimesters = {
                    'First Trimester': 'Weeks 1-12',
                    'Second Trimester': 'Weeks 13-26',
                    'Third Trimester': 'Weeks 27-40'
                  };
                  return trimesters[context.dataset.label];
                }
              }
            }
          }
        },
        plugins: [{
          id: 'pregnancyMarker',
          afterDraw: function(chart) {
            const ctx = chart.ctx;
            const xAxis = chart.scales.x;
            const yAxis = chart.scales.y;
            const chartArea = chart.chartArea;
            
            // Draw vertical line at current week
            const xPixel = xAxis.getPixelForValue(currentProgress);
            
            if (xPixel >= chartArea.left && xPixel <= chartArea.right) {
              ctx.save();
              ctx.beginPath();
              ctx.moveTo(xPixel, chartArea.top);
              ctx.lineTo(xPixel, chartArea.bottom);
              ctx.lineWidth = 2;
              ctx.strokeStyle = '#333333';
              ctx.stroke();
              
              // Add "You are here" label
              ctx.fillStyle = '#333333';
              ctx.font = 'bold 12px Arial';
              ctx.textAlign = 'center';
              ctx.fillText('You are here', xPixel, chartArea.top - 10);
              ctx.restore();
            }
          }
        }]
      });
    }
  });
</script>

