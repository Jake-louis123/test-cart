<script>
  document.addEventListener('DOMContentLoaded', function() {
    const unitSelector = document.getElementById('unitSelector');
    const metricInputs = document.getElementById('metricInputs');
    const imperialInputs = document.getElementById('imperialInputs');
    const calculateButton = document.getElementById('calculateButton');
    const resultContainer = document.getElementById('resultContainer');
    const ctaContainer = document.getElementById('ctaContainer');
    const bmrValue = document.getElementById('bmrValue');
    const maintainCalories = document.getElementById('maintainCalories');
    const loseCalories = document.getElementById('loseCalories');
    const gainCalories = document.getElementById('gainCalories');
    const dynamicCta = document.getElementById('dynamicCta');
    
    let calorieChart = null;
    
    // Handle unit switching
    unitSelector.addEventListener('change', function(e) {
      if (e.target.value === 'metric') {
        metricInputs.style.display = 'block';
        imperialInputs.style.display = 'none';
      } else if (e.target.value === 'imperial') {
        metricInputs.style.display = 'none';
        imperialInputs.style.display = 'block';
      }
    });
    
    // Calculate calories
    calculateButton.addEventListener('click', function() {
      // Reset previous errors
      document.querySelectorAll('.error-message').forEach(el => el.textContent = '');
      document.querySelectorAll('input').forEach(el => el.classList.remove('error'));
      
      // Get selected unit
      const selectedUnit = document.querySelector('input[name="units"]:checked').value;
      
      // Get common inputs
      const age = parseInt(document.getElementById('age').value);
      const gender = document.getElementById('gender').value;
      const activityLevel = parseFloat(document.getElementById('activity').value);
      const goal = document.getElementById('goal').value;
      
      let weight = 0;
      let height = 0;
      let isValid = true;
      
      // Validate age
      if (isNaN(age) || age < 15 || age > 100) {
        document.getElementById('age-error').textContent = 'Please enter a valid age (15-100)';
        document.getElementById('age').classList.add('error');
        isValid = false;
      }
      
      if (selectedUnit === 'metric') {
        height = parseFloat(document.getElementById('height-cm').value);
        weight = parseFloat(document.getElementById('weight-kg').value);
        
        // Validate inputs
        if (isNaN(height) || height <= 0) {
          document.getElementById('height-cm-error').textContent = 'Please enter a valid height';
          document.getElementById('height-cm').classList.add('error');
          isValid = false;
        }
        
        if (isNaN(weight) || weight <= 0) {
          document.getElementById('weight-kg-error').textContent = 'Please enter a valid weight';
          document.getElementById('weight-kg').classList.add('error');
          isValid = false;
        }
      } else {
        height = parseFloat(document.getElementById('height-in').value);
        weight = parseFloat(document.getElementById('weight-lbs').value);
        
        // Validate inputs
        if (isNaN(height) || height <= 0) {
          document.getElementById('height-in-error').textContent = 'Please enter a valid height';
          document.getElementById('height-in').classList.add('error');
          isValid = false;
        }
        
        if (isNaN(weight) || weight <= 0) {
          document.getElementById('weight-lbs-error').textContent = 'Please enter a valid weight';
          document.getElementById('weight-lbs').classList.add('error');
          isValid = false;
        }
        
        // Convert to metric for calculation
        weight = weight / 2.20462; // lbs to kg
        height = height * 2.54;    // in to cm
      }
      
      if (isValid) {
        // Calculate BMR using Mifflin-St Jeor Equation
        let bmr = 0;
        
        if (gender === 'male') {
          bmr = (10 * weight) + (6.25 * height) - (5 * age) + 5;
        } else {
          bmr = (10 * weight) + (6.25 * height) - (5 * age) - 161;
        }
        
        // Calculate TDEE (Total Daily Energy Expenditure)
        const tdee = Math.round(bmr * activityLevel);
        
        // Calculate calorie targets
        const maintain = tdee;
        const lose = Math.round(tdee - 500);
        const gain = Math.round(tdee + 500);
        
        // Display results
        bmrValue.textContent = Math.round(bmr);
        maintainCalories.textContent = maintain;
        loseCalories.textContent = lose;
        gainCalories.textContent = gain;
        
        // Create or update chart
        createCalorieChart(maintain, lose, gain);
        
        // Determine CTA text based on selected goal
        let ctaText = '';
        
        switch(goal) {
          case 'lose':
            ctaText = "You've got your calorie target—nice work! Now, the key is to stick with it, and that means making sure you're not skimping on vitamins and minerals while cutting back. Let's be real: it's easy to miss out on nutrients when you're watching what you eat, and that can leave you feeling sluggish.<br><br>Our pill organizer? Total game-changer. Toss your multivitamins or fiber supplements into the daily compartments once a week, and you'll never have that \"Did I take them today?\" panic. It's one small thing that keeps you nourished and energized—so you can crush those weight loss goals without feeling run down. Makes the whole process feel way more doable.";
            break;
          case 'maintain':
            ctaText = "Keeping that perfect balance? It's all about the small, consistent habits—and you're already on top of it. Taking your daily vitamins and minerals is like giving your body a little \"thank you\" for keeping things steady—boosts energy, keeps your immune system happy, all that good stuff.<br><br>But let's be honest: juggling a bunch of supplement bottles? Annoying. Our pill organizer simplifies it. Spend 2 minutes on Sunday prepping your week's doses, and suddenly those bottles cluttering your counter? Gone. It's a tiny ritual that makes self-care feel effortless—because you've got better things to do than hunt for pills. Adds a little calm to your routine.";
            break;
          case 'gain':
            ctaText = "Gaining weight the right way? It's not just about eating more—it's about fueling your body to build strength, and that means nailing those nutrients. B vitamins to keep your energy up during workouts, protein supplements to support muscle growth… they're all key, but remembering to take them? Ugh.<br><br>Our pill organizer takes the stress out of it. Fill it once a week with your supplements and boom—no more \"Did I miss a dose?\" It lets you focus on what matters: eating well, hitting the gym, and seeing those gains. Let it handle the details so you can crush your goals. Your muscles will thank you.";
            break;
        }
        
        // Update CTA
        dynamicCta.innerHTML = ctaText;
        
        // Show results
        resultContainer.classList.add('show');
        ctaContainer.style.display = 'block';
        
        // Scroll to results
        resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
    
    // Create calorie chart
    function createCalorieChart(maintain, lose, gain) {
      const ctx = document.getElementById('calorieChart').getContext('2d');
      
      // Destroy previous chart if exists
      if (calorieChart) {
        calorieChart.destroy();
      }
      
      calorieChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Lose Weight', 'Maintain Weight', 'Gain Weight'],
          datasets: [{
            label: 'Daily Calories',
            data: [lose, maintain, gain],
            backgroundColor: [
              '#84B7B6',
              '#2D5F5D',
              '#50817F'
            ],
            borderColor: [
              '#84B7B6',
              '#2D5F5D',
              '#50817F'
            ],
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: false,
              min: Math.min(lose, maintain, gain) * 0.8,
              title: {
                display: true,
                text: 'Calories',
                color: '#333333'
              }
            },
            x: {
              title: {
                display: true,
                text: 'Goal',
                color: '#333333'
              }
            }
          },
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return context.parsed.y + ' calories';
                }
              }
            }
          }
        }
      });
    }
  });
</script>

