<!-- Add Chart.js for visualization -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const calculateButton = document.getElementById('calculateButton');
    const resultContainer = document.getElementById('resultContainer');
    const ctaContainer = document.getElementById('ctaContainer');
    const maxHR = document.getElementById('maxHR');
    const moderateZone = document.getElementById('moderateZone');
    const vigorousZone = document.getElementById('vigorousZone');
    const dynamicCta = document.getElementById('dynamicCta');
    
    let heartRateChart = null;
    
    // Calculate target heart rate
    calculateButton.addEventListener('click', function() {
      // Reset previous errors
      document.querySelectorAll('.error-message').forEach(el => el.textContent = '');
      document.querySelectorAll('input').forEach(el => el.classList.remove('error'));
      
      // Get input
      const age = parseInt(document.getElementById('age').value);
      
      let isValid = true;
      
      // Validate input
      if (isNaN(age) || age < 1 || age > 120) {
        document.getElementById('age-error').textContent = 'Please enter a valid age (1-120)';
        document.getElementById('age').classList.add('error');
        isValid = false;
      }
      
      if (isValid) {
        // Calculate estimated maximum heart rate
        // Formula: MHR = 220 - age
        const maxHeartRate = 220 - age;
        
        // Calculate moderate intensity zone (50-70% of MHR)
        const moderateLower = Math.round(maxHeartRate * 0.5);
        const moderateUpper = Math.round(maxHeartRate * 0.7);
        
        // Calculate vigorous intensity zone (70-85% of MHR)
        const vigorousLower = Math.round(maxHeartRate * 0.7);
        const vigorousUpper = Math.round(maxHeartRate * 0.85);
        
        // Update the display
        maxHR.textContent = maxHeartRate;
        moderateZone.textContent = `${moderateLower} - ${moderateUpper} bpm`;
        vigorousZone.textContent = `${vigorousLower} - ${vigorousUpper} bpm`;
        
        // Create heart rate zone chart
        createHeartRateChart(maxHeartRate, moderateLower, moderateUpper, vigorousLower, vigorousUpper);
        
        // Set CTA text
        const ctaText = "Great job nailing down your target heart rate zone—that's the first step to making every workout count! Now, to keep that momentum going and help your body recover like a pro, you're probably reaching for supplements: electrolytes to stay hydrated, BCAAs to support those muscles, or CoQ10 for that extra energy boost. Makes total sense—but let's be real, remembering *when* to take what? It can get messy.<br><br>Our pill organizer takes the guesswork out. Sort your pre-workout energizers, mid-day vitamins, and evening recovery supplements into clearly labeled compartments once a week, and suddenly you're not digging through bottles mid-rush or forgetting that crucial post-workout protein. It's a small change that keeps your supplement game as disciplined as your fitness routine. Because when you're putting in the work, you deserve to get all the benefits.";
        
        // Update CTA
        dynamicCta.innerHTML = ctaText;
        
        // Show results
        resultContainer.classList.add('show');
        ctaContainer.style.display = 'block';
        
        // Scroll to results
        resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
    
    // Create heart rate zone chart
    function createHeartRateChart(maxHR, modLower, modUpper, vigLower, vigUpper) {
      const ctx = document.getElementById('heartRateChart').getContext('2d');
      
      // Destroy previous chart if exists
      if (heartRateChart) {
        heartRateChart.destroy();
      }
      
      // Calculate segments for chart
      const restingSegment = modLower;
      const moderateSegment = modUpper - modLower;
      const vigorousSegment = vigUpper - vigLower;
      const maxSegment = maxHR - vigUpper;
      
      heartRateChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Heart Rate Zones'],
          datasets: [
            {
              label: 'Resting (<50%)',
              data: [restingSegment],
              backgroundColor: '#E8F3F3',
              borderColor: '#84B7B6',
              borderWidth: 1
            },
            {
              label: 'Moderate (50-70%)',
              data: [moderateSegment],
              backgroundColor: '#84B7B6',
              borderColor: '#84B7B6',
              borderWidth: 1
            },
            {
              label: 'Vigorous (70-85%)',
              data: [vigorousSegment],
              backgroundColor: '#2D5F5D',
              borderColor: '#2D5F5D',
              borderWidth: 1
            },
            {
              label: 'Maximum (>85%)',
              data: [maxSegment],
              backgroundColor: '#50817F',
              borderColor: '#50817F',
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: 'y',
          scales: {
            x: {
              stacked: true,
              min: 0,
              max: maxHR + 10,
              title: {
                display: true,
                text: 'Heart Rate (BPM)',
                color: '#333333'
              },
              ticks: {
                callback: function(value) {
                  return value + ' bpm';
                }
              }
            },
            y: {
              stacked: true,
              grid: {
                display: false
              }
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                padding: 15
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const zones = {
                    'Resting (<50%)': `0-${modLower} bpm`,
                    'Moderate (50-70%)': `${modLower}-${modUpper} bpm`,
                    'Vigorous (70-85%)': `${vigLower}-${vigUpper} bpm`,
                    'Maximum (>85%)': `${vigUpper}-${maxHR} bpm`
                  };
                  return zones[context.dataset.label];
                }
              }
            }
          }
        }
      });
    }
  });
</script>

