<script>
  document.addEventListener('DOMContentLoaded', function() {
    const calculateButton = document.getElementById('calculateButton');
    const resultContainer = document.getElementById('resultContainer');
    const ctaContainer = document.getElementById('ctaContainer');
    const bpValue = document.getElementById('bpValue');
    const bpCategory = document.getElementById('bpCategory');
    const dynamicCta = document.getElementById('dynamicCta');
    
    let bpGaugeChart = null;
    
    // Calculate blood pressure category
    calculateButton.addEventListener('click', function() {
      // Reset previous errors
      document.querySelectorAll('.error-message').forEach(el => el.textContent = '');
      document.querySelectorAll('input').forEach(el => el.classList.remove('error'));
      
      // Get inputs
      const systolic = parseInt(document.getElementById('systolic').value);
      const diastolic = parseInt(document.getElementById('diastolic').value);
      
      let isValid = true;
      
      // Validate inputs
      if (isNaN(systolic) || systolic < 70 || systolic > 250) {
        document.getElementById('systolic-error').textContent = 'Please enter a valid systolic pressure (70-250)';
        document.getElementById('systolic').classList.add('error');
        isValid = false;
      }
      
      if (isNaN(diastolic) || diastolic < 40 || diastolic > 150) {
        document.getElementById('diastolic-error').textContent = 'Please enter a valid diastolic pressure (40-150)';
        document.getElementById('diastolic').classList.add('error');
        isValid = false;
      }
      
      if (isValid) {
        // Determine blood pressure category
        let category = '';
        let categoryClass = '';
        let gaugeValue = 0;
        let ctaText = '';
        
        // Logic tree based on AHA guidelines
        if (systolic > 180 || diastolic > 120) {
          category = 'Hypertensive Crisis - Seek Emergency Care!';
          categoryClass = 'category-danger';
          gaugeValue = 5; // Position on gauge
          ctaText = "First off—kudos for staying on top of this. Managing blood pressure at this stage means being super consistent with your meds, and we get it: that can feel like a lot. Missing a dose even once? Stressful, and we want to take that worry off your plate.<br><br>Our pill organizer is designed for exactly this: clear, labeled compartments for each day and dose, so you can see at a glance if you've taken your meds. No more guessing, no more last-minute panic. Spend 5 minutes on Sunday prepping, and the rest of the week? Smooth sailing. It's not just a tool—it's peace of mind, so you can focus on feeling your best. Because you deserve one less thing to stress about.";
        } else if (systolic >= 140 || diastolic >= 90) {
          category = 'Hypertension Stage 2';
          categoryClass = 'category-danger';
          gaugeValue = 4; // Position on gauge
          ctaText = "First off—kudos for staying on top of this. Managing blood pressure at this stage means being super consistent with your meds, and we get it: that can feel like a lot. Missing a dose even once? Stressful, and we want to take that worry off your plate.<br><br>Our pill organizer is designed for exactly this: clear, labeled compartments for each day and dose, so you can see at a glance if you've taken your meds. No more guessing, no more last-minute panic. Spend 5 minutes on Sunday prepping, and the rest of the week? Smooth sailing. It's not just a tool—it's peace of mind, so you can focus on feeling your best. Because you deserve one less thing to stress about.";
        } else if (systolic >= 130 || diastolic >= 80) {
          category = 'Hypertension Stage 1';
          categoryClass = 'category-warning';
          gaugeValue = 3; // Position on gauge
          ctaText = "First off—kudos for staying on top of this. Managing blood pressure at this stage means being super consistent with your meds, and we get it: that can feel like a lot. Missing a dose even once? Stressful, and we want to take that worry off your plate.<br><br>Our pill organizer is designed for exactly this: clear, labeled compartments for each day and dose, so you can see at a glance if you've taken your meds. No more guessing, no more last-minute panic. Spend 5 minutes on Sunday prepping, and the rest of the week? Smooth sailing. It's not just a tool—it's peace of mind, so you can focus on feeling your best. Because you deserve one less thing to stress about.";
        } else if (systolic >= 120 && diastolic < 80) {
          category = 'Elevated Blood Pressure';
          categoryClass = 'category-warning';
          gaugeValue = 2; // Position on gauge
          ctaText = "Heads up—this is your body giving you a gentle nudge to pay a little extra attention to your heart health. No need to panic, but it's a good reminder to lean into those small changes: maybe more veggies, a little less salt, or sticking to any supplements your doc suggested.<br><br>The tricky part? Remembering to take those supplements daily. Our pill organizer? It's like a little helper. Fill it once a week, set it by your bag, and you'll see it first thing. No more \"Did I take that today?\" It's one simple step to build a solid habit—so you can stay on top of things and keep that blood pressure in check. Takes the hassle out of self-care.";
        } else if (systolic < 120 && diastolic < 80) {
          category = 'Normal Blood Pressure';
          categoryClass = 'category-normal';
          gaugeValue = 1; // Position on gauge
          ctaText = "Awesome news—your blood pressure's right where it should be! That's proof all those little healthy habits (the walks, the balanced meals) are paying off. If you're taking supplements like fish oil or vitamin D to keep that heart happy, good call—consistency is key here.<br><br>But let's be real: remembering to take them every single day? It's easy to slip up, especially on busy mornings. Our pill organizer takes that stress away. Spend 5 minutes on Sunday divvying up your weekly doses, and suddenly it's just… done. No more rummaging through bottles or second-guessing. It's a tiny way to make that healthy routine feel effortless—because you're already nailing the big stuff. Keeps that momentum going, easy peasy.";
        } else {
          category = 'Invalid reading';
          categoryClass = 'category-info';
          gaugeValue = 0;
          ctaText = "It looks like there might be something unusual about your reading. Blood pressure readings can sometimes be inaccurate due to many factors. Try taking another reading after resting for 5 minutes, making sure the cuff is properly positioned.<br><br>Consistent monitoring is key to managing heart health. Our pill organizer can help if you're taking supplements or medications for your heart. It makes it easy to stay on track with your health regimen by giving you a clear visual of what to take and when. Keeping up with your heart health routine shouldn't add stress to your day.";
        }
        
        // Update the display
        bpValue.textContent = `${systolic}/${diastolic}`;
        bpCategory.textContent = category;
        bpCategory.className = 'result-category ' + categoryClass;
        
        // Create or update gauge chart
        createBPGaugeChart(gaugeValue);
        
        // Update CTA
        dynamicCta.innerHTML = ctaText;
        
        // Show results
        resultContainer.classList.add('show');
        ctaContainer.style.display = 'block';
        
        // Scroll to results
        resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
    
    // Create blood pressure gauge chart
    function createBPGaugeChart(value) {
      const ctx = document.getElementById('bpGauge').getContext('2d');
      
      // Destroy previous chart if exists
      if (bpGaugeChart) {
        bpGaugeChart.destroy();
      }
      
      // Chart configuration
      bpGaugeChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
          datasets: [{
            data: [1, 1, 1, 1, 1, 5],
            backgroundColor: [
              '#2D5F5D',  // Normal
              '#84B7B6',  // Elevated
              '#f1c40f',  // Stage 1
              '#e67e22',  // Stage 2
              '#e74c3c',  // Crisis
              '#E8F3F3'   // Background
            ],
            borderWidth: 0,
            circumference: 180,
            rotation: 270
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '70%',
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              enabled: false
            }
          }
        },
        plugins: [{
          id: 'bloodPressureNeedle',
          afterDraw: function(chart) {
            if (value >= 0) {
              const ctx = chart.ctx;
              const xCenter = chart.chartArea.width / 2 + chart.chartArea.left;
              const yCenter = chart.chartArea.bottom;
              const radius = chart.innerRadius * 0.8;
              
              // Calculate needle position based on blood pressure category (0-5)
              // Convert to angle in radians (0 = straight up, Math.PI = straight down)
              const angleRad = (value / 5) * Math.PI;
              
              // Calculate endpoint of needle
              const xEnd = xCenter + radius * Math.cos(angleRad);
              const yEnd = yCenter - radius * Math.sin(angleRad);
              
              // Draw needle
              ctx.save();
              ctx.beginPath();
              ctx.moveTo(xCenter, yCenter);
              ctx.lineTo(xEnd, yEnd);
              ctx.lineWidth = 3;
              ctx.strokeStyle = '#333333';
              ctx.stroke();
              
              // Draw circle at needle pivot
              ctx.beginPath();
              ctx.arc(xCenter, yCenter, 5, 0, 2 * Math.PI);
              ctx.fillStyle = '#333333';
              ctx.fill();
              
              // Add category labels
              ctx.textAlign = 'center';
              ctx.fillStyle = '#333333';
              ctx.font = '11px Arial';
              
              // Position labels around gauge
              const labelRadius = radius * 1.15;
              
              // Normal
              let angle = 0.1 * Math.PI;
              let x = xCenter + labelRadius * Math.cos(angle);
              let y = yCenter - labelRadius * Math.sin(angle);
              ctx.fillText('Normal', x, y);
              
              // Elevated
              angle = 0.3 * Math.PI;
              x = xCenter + labelRadius * Math.cos(angle);
              y = yCenter - labelRadius * Math.sin(angle);
              ctx.fillText('Elevated', x, y);
              
              // Stage 1
              angle = 0.5 * Math.PI;
              x = xCenter + labelRadius * Math.cos(angle);
              y = yCenter - labelRadius * Math.sin(angle);
              ctx.fillText('Stage 1', x, y);
              
              // Stage 2
              angle = 0.7 * Math.PI;
              x = xCenter + labelRadius * Math.cos(angle);
              y = yCenter - labelRadius * Math.sin(angle);
              ctx.fillText('Stage 2', x, y);
              
              // Crisis
              angle = 0.9 * Math.PI;
              x = xCenter + labelRadius * Math.cos(angle);
              y = yCenter - labelRadius * Math.sin(angle);
              ctx.fillText('Crisis', x, y);
              
              ctx.restore();
            }
          }
        }]
      });
    }
  });
</script>

