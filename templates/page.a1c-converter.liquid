<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const calculateButton = document.getElementById('calculateButton');
    const resultContainer = document.getElementById('resultContainer');
    const ctaContainer = document.getElementById('ctaContainer');
    const mgdlValue = document.getElementById('mgdlValue');
    const mmolValue = document.getElementById('mmolValue');
    const a1cCategory = document.getElementById('a1cCategory');
    const dynamicCta = document.getElementById('dynamicCta');
    
    let a1cChart = null;
    
    // Convert A1C to eAG
    calculateButton.addEventListener('click', function() {
      // Reset previous errors
      document.querySelectorAll('.error-message').forEach(el => el.textContent = '');
      document.querySelectorAll('input').forEach(el => el.classList.remove('error'));
      
      // Get input
      const a1cValue = parseFloat(document.getElementById('a1c').value);
      
      let isValid = true;
      
      // Validate input
      if (isNaN(a1cValue) || a1cValue < 4 || a1cValue > 14) {
        document.getElementById('a1c-error').textContent = 'Please enter a valid A1C value (4-14%)';
        document.getElementById('a1c').classList.add('error');
        isValid = false;
      }
      
      if (isValid) {
        // Calculate estimated average glucose (eAG)
        // Formula: eAG (mg/dL) = (28.7 * A1C) - 46.7
        const eAGmgdl = (28.7 * a1cValue) - 46.7;
        
        // Convert to mmol/L: divide mg/dL by 18
        const eAGmmol = eAGmgdl / 18;
        
        // Determine category and CTA
        let category = '';
        let categoryClass = '';
        let ctaText = '';
        
        if (a1cValue < 5.7) {
          category = 'Normal (Non-diabetic range)';
          categoryClass = 'category-normal';
          ctaText = "Your A1C level is in the normal range, which is excellent! Maintaining these healthy numbers is all about consistency—something you're clearly good at already. If you're taking any daily supplements to support your metabolic health, keeping that routine strong is key.<br><br>Our pill organizer is perfect for that 'set it and forget it' approach to health maintenance. Sort your supplements just once a week into the daily compartments, and you'll never have to wonder if you remembered your vitamins that morning. It's a simple way to maintain your already-stellar health habits without adding any extra thought to your day. Keep up the great work!";
        } else if (a1cValue < 6.5) {
          category = 'Prediabetes range';
          categoryClass = 'category-warning';
          ctaText = "Your A1C is in the prediabetes range—this is actually good news because it means you have the opportunity to make changes before diabetes develops. If your doctor has recommended supplements like alpha-lipoic acid, chromium, or a specific vitamin regimen, consistency will be your best ally.<br><br>Our pill organizer takes the guesswork out of your daily routine. Fill it once a week with your recommended supplements, and it's right there reminding you each day. No more 'Did I take that today?' moments or finding half-empty bottles months later. It's a simple tool that helps you stay on track with those small daily actions that can make a big difference in your health journey.";
        } else if (a1cValue < 7) {
          category = 'Diabetes range (within target for many adults)';
          categoryClass = 'category-warning';
          ctaText = "Wow, that's amazing—all those little daily efforts over the past few months? They're clearly paying off, and you should be so proud! Keeping that A1c steady means sticking with what's working, whether that's your meds, supplements, or those smart food choices you've been nailing.<br><br>But let's be real: remembering *every single day* to take what you need? It can sneak up on you. Our pill organizer takes that pressure off. Spend 5 minutes on Sunday sorting your meds and vitamins into the daily slots, and then… done. No more digging through bottles or second-guessing if you took them. It's a tiny, easy way to keep that momentum going—so you can keep crushing those goals without the hassle. Makes consistency feel like a breeze.";
        } else {
          category = 'Diabetes range (above target for many adults)';
          categoryClass = 'category-danger';
          ctaText = "First off, noticing this is a big step—props to you for staying on top of it. This is just a sign to chat with your doc about tweaks to your plan, and whatever they suggest (new meds, adjusted supplements), sticking to it will be key.<br><br>The tricky part? Keeping track of it all. Our pill organizer is here to simplify things: 7 oversized compartments for a week's worth of wellness. No more mixing up pills or stressing about missed doses. Spend a few minutes prepping once a week, and you'll feel that much more in control. It's like having a little backup to make sure you're nailing that new plan—so you can get back to that target range. Takes the guesswork out of the process.";
        }
        
        // Update the display
        mgdlValue.textContent = eAGmgdl.toFixed(1) + ' mg/dL';
        mmolValue.textContent = eAGmmol.toFixed(1) + ' mmol/L';
        a1cCategory.textContent = category;
        a1cCategory.className = 'result-category ' + categoryClass;
        
        // Create A1C chart
        createA1CChart(a1cValue);
        
        // Update CTA
        dynamicCta.innerHTML = ctaText;
        
        // Show results
        resultContainer.classList.add('show');
        ctaContainer.style.display = 'block';
        
        // Scroll to results
        resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
    
    // Create A1C chart
    function createA1CChart(a1cValue) {
      const ctx = document.getElementById('a1cChart').getContext('2d');
      
      // Destroy previous chart if exists
      if (a1cChart) {
        a1cChart.destroy();
      }
      
      // Create dataset with ranges
      const data = {
        labels: ['Normal', 'Prediabetes', 'Diabetes'],
        datasets: [
          {
            label: 'A1C Ranges',
            data: [5.6, 6.4, 14],
            backgroundColor: [
              '#2D5F5D',  // Normal
              '#84B7B6',  // Prediabetes
              '#e74c3c'   // Diabetes
            ],
            borderColor: '#E8F3F3',
            borderWidth: 1
          }
        ]
      };
      
      // Create chart
      a1cChart = new Chart(ctx, {
        type: 'bar',
        data: data,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: 'y',
          scales: {
            x: {
              stacked: true,
              min: 4,
              max: 14,
              title: {
                display: true,
                text: 'A1C Value (%)',
                color: '#333333'
              }
            },
            y: {
              beginAtZero: true,
              grid: {
                display: false
              }
            }
          },
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const ranges = {
                    'Normal': 'Below 5.7%',
                    'Prediabetes': '5.7% - 6.4%',
                    'Diabetes': '6.5% and above'
                  };
                  return ranges[context.label];
                }
              }
            },
            annotation: {
              annotations: {
                line1: {
                  type: 'line',
                  xMin: a1cValue,
                  xMax: a1cValue,
                  yMin: -0.5,
                  yMax: 2.5,
                  borderColor: '#333333',
                  borderWidth: 2,
                  borderDash: [5, 5],
                  label: {
                    content: 'Your A1C: ' + a1cValue + '%',
                    enabled: true,
                    position: 'top'
                  }
                }
              }
            }
          }
        },
        plugins: [{
          id: 'a1cMarker',
          afterDraw: function(chart) {
            const ctx = chart.ctx;
            const xAxis = chart.scales.x;
            const yAxis = chart.scales.y;
            const chartArea = chart.chartArea;
            
            // Draw vertical line at user's A1C value
            const xPixel = xAxis.getPixelForValue(a1cValue);
            
            if (xPixel >= chartArea.left && xPixel <= chartArea.right) {
              ctx.save();
              ctx.beginPath();
              ctx.moveTo(xPixel, chartArea.top);
              ctx.lineTo(xPixel, chartArea.bottom);
              ctx.lineWidth = 2;
              ctx.strokeStyle = '#333333';
              ctx.setLineDash([5, 5]);
              ctx.stroke();
              
              // Add label
              ctx.fillStyle = '#333333';
              ctx.font = 'bold 12px Arial';
              ctx.textAlign = 'center';
              ctx.fillText('Your A1C: ' + a1cValue + '%', xPixel, chartArea.top - 10);
              ctx.restore();
            }
          }
        }]
      });
    }
  });
</script>

